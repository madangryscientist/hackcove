{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "ui",
  "root": "packages/ui",
  "sourceRoot": "packages/ui/src",
  "projectType": "library",
  "tags": ["scope:ui", "kind:package"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{projectRoot}/dist"],
      "options": { "command": "bun run build", "cwd": "packages/ui" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit", "cwd": "packages/ui" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings && bun ../../scripts/check-slop.ts",
        "cwd": "packages/ui"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": { "command": "vitest run", "cwd": "packages/ui" }
    },
    "pack-check": {
      "executor": "nx:run-commands",
      "options": { "command": "npm pack --dry-run", "cwd": "packages/ui" }
    }
  }
}
