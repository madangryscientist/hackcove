{
  "name": "@hackcove/ui",
  "version": "0.2.1",
  "description": "Hack Cove React components: primitives, typography roles and a safe Markdown renderer, written against Tailwind v4 utilities. Pair with a @hackcove/theme-* package.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madangryscientist/hackcove.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings && bun ../../scripts/check-slop.ts",
    "test": "vitest run",
    "pack-check": "npm pack --dry-run",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "tailwindcss": "^4"
  },
  "nx": {
    "name": "ui",
    "tags": [
      "kind:package"
    ],
    "targets": {
      "build": {
        "outputs": [
          "{projectRoot}/dist"
        ]
      }
    }
  }
}
