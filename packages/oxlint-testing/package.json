{
  "name": "@hackcove/oxlint-testing",
  "version": "0.1.0",
  "description": "A shared oxlint config and plugin for UI tests (Playwright, Testing Library, Vitest): find elements the way a user does, wait on a state, assert behaviour not look, and keep one Playwright config shape.",
  "keywords": [
    "e2e",
    "eslint-plugin-playwright",
    "eslint-plugin-testing-library",
    "hackcove",
    "lint",
    "oxlint",
    "playwright",
    "testing-library",
    "vitest"
  ],
  "homepage": "https://github.com/madangryscientist/hackcove/tree/main/packages/oxlint-testing#readme",
  "bugs": {
    "url": "https://github.com/madangryscientist/hackcove/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jacobus Langner",
    "url": "https://github.com/madangryscientist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madangryscientist/hackcove.git",
    "directory": "packages/oxlint-testing"
  },
  "files": [
    ".oxlintrc.json",
    "plugin.js",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    "./.oxlintrc.json": "./.oxlintrc.json",
    "./plugin.js": "./plugin.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings --ignore-pattern 'fixtures/**' && bun ../../scripts/check-slop.ts",
    "test": "vitest run --dir test",
    "pack-check": "npm pack --dry-run --json --ignore-scripts | bun scripts/pack-files.ts && bun scripts/consumer.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "eslint-plugin-playwright": "2.12.2",
    "eslint-plugin-testing-library": "7.16.2",
    "oxlint": "1.89.0"
  },
  "nx": {
    "name": "oxlint-testing"
  }
}
