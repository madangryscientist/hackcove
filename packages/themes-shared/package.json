{
  "name": "@hackcove/themes-shared",
  "version": "0.0.0",
  "private": true,
  "description": "How the repo's own apps (Storybook, the docs) find the themes: the themes/*.css glob, each file's theme id and the scope-class rule. Not published.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./scope": "./src/scope.ts",
    "./ids": "./src/ids.ts",
    "./files": "./src/files.ts",
    "./colour": "./src/colour.ts",
    "./contrast": "./src/contrast.ts",
    "./utilities": "./src/utilities.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings && bun ../../scripts/check-slop.ts",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "nx": {
    "name": "themes-shared",
    "tags": [
      "kind:internal"
    ],
    "targets": {
      "typecheck": {
        "inputs": [
          "default"
        ]
      }
    }
  }
}
