{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.shared.json",
      "{workspaceRoot}/.oxlintrc.json",
      "{workspaceRoot}/nx.json"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": true
    },
    "typecheck": {
      "cache": true
    },
    "lint": {
      "cache": true
    },
    "pack-check": {
      "cache": true,
      "dependsOn": ["build"]
    },
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["build"],
      "options": {
        "packageRoot": "{projectRoot}",
        "access": "public"
      }
    }
  },
  "analytics": false,
  "cli": {
    "packageManager": "npm"
  },
  "release": {
    "projects": ["ui", "theme-*"],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "conventionalCommits": true,
      "adjustSemverBumpsForZeroMajorVersion": true,
      "versionActions": "./scripts/release-version-actions.cjs"
    },
    "conventionalCommits": {
      "useCommitScope": false,
      "types": {
        "perf": {
          "semverBump": "patch"
        }
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "file": "CHANGELOG.md",
        "createRelease": "github"
      }
    }
  },
  "plugins": ["./apps/storybook/scripts/nx-plugin.ts"]
}
