{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "targetDefaults": {
    "nx-release-publish": {
      "executor": "@nx/js:release-publish",
      "dependsOn": ["build"],
      "options": {
        "packageRoot": "{projectRoot}",
        "access": "public"
      }
    }
  },
  "analytics": false,
  "cli": {
    "packageManager": "npm"
  },
  "release": {
    "projects": ["ui-react", "themes"],
    "projectsRelationship": "independent",
    "releaseTag": {
      "pattern": "{projectName}@{version}"
    },
    "version": {
      "conventionalCommits": true,
      "adjustSemverBumpsForZeroMajorVersion": true,
      "versionActions": "./scripts/release-version-actions.cjs"
    },
    "conventionalCommits": {
      "useCommitScope": false,
      "types": {
        "perf": {
          "semverBump": "patch"
        }
      }
    },
    "changelog": {
      "workspaceChangelog": false,
      "projectChangelogs": {
        "file": "CHANGELOG.md",
        "createRelease": "github"
      }
    }
  }
}
