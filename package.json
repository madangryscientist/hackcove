{
  "name": "@hackcove/themes",
  "version": "0.1.0",
  "description": "The Hack Cove design system: a Catppuccin Mocha theme layer for Tailwind v4 and the React components built on it.",
  "license": "SEE LICENSE IN LICENSE",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/theme.css dist/theme.css",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings && bun scripts/check-slop.ts",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "pack:check": "bun run build && npm pack --dry-run",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.2",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "tailwindcss": "^4.3.3"
  }
}
