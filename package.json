{
  "name": "hackcove",
  "private": true,
  "workspaces": [
    "packages/*",
    "tools/*",
    "themes",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "moon run --concurrency 3 :build",
    "typecheck": "moon run --concurrency 3 :typecheck",
    "lint": "moon run --concurrency 3 :lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "moon run --concurrency 3 :test",
    "pack:check": "moon run --concurrency 3 :pack-check",
    "storybook": "moon run storybook:storybook"
  },
  "devDependencies": {
    "@moonrepo/cli": "2.6.5",
    "@nx/js": "23.3.0",
    "@playwright/test": "1.64.1",
    "@types/bun": "1.4.3",
    "nx": "23.3.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  },
  "browserslist": [
    "chrome >= 131",
    "edge >= 131",
    "firefox >= 143",
    "safari >= 18.4",
    "ios_saf >= 18.4"
  ]
}
