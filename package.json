{
  "name": "hackcove",
  "private": true,
  "workspaces": [
    "packages/*",
    "themes/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "nx run-many -t build",
    "typecheck": "nx run-many -t typecheck",
    "lint": "nx run-many -t lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "nx run-many -t test",
    "pack:check": "nx run-many -t pack-check",
    "storybook": "nx run storybook:storybook"
  },
  "devDependencies": {
    "@nx/js": "23.3.0",
    "@types/bun": "1.4.3",
    "nx": "23.3.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
