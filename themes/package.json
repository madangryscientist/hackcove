{
  "name": "@slashsuite/themes",
  "version": "0.3.2",
  "description": "The UISlash themes: one CSS file per theme, each remapping the Tailwind utilities @slashsuite/ui-react is written against.",
  "keywords": [
    "dark-mode",
    "design-system",
    "light-mode",
    "slashsuite",
    "tailwind",
    "tailwindcss",
    "theme"
  ],
  "homepage": "https://github.com/slashsuite/uislash/tree/main/themes#readme",
  "bugs": {
    "url": "https://github.com/slashsuite/uislash/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jacobus Langner",
    "url": "https://github.com/madangryscientist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slashsuite/uislash.git",
    "directory": "themes"
  },
  "files": [
    "*.css",
    "NOTICE",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./*.css": "./*.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../.oxlintrc.json --type-aware --deny-warnings && bun ../scripts/check-slop.ts",
    "test": "vitest run",
    "pack-check": "npm pack --dry-run --json --ignore-scripts | bun scripts/pack-files.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "tailwindcss": "^4.3.5",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "nx": {
    "name": "themes"
  }
}
