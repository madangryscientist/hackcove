{
  "name": "@hackcove/themes",
  "version": "0.2.1",
  "description": "The Hack Cove themes: one CSS file per theme, each remapping the Tailwind utilities @hackcove/ui-react is written against.",
  "keywords": [
    "dark-mode",
    "design-system",
    "hackcove",
    "light-mode",
    "tailwind",
    "tailwindcss",
    "theme"
  ],
  "homepage": "https://github.com/madangryscientist/hackcove/tree/main/themes#readme",
  "bugs": {
    "url": "https://github.com/madangryscientist/hackcove/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jacobus Langner",
    "url": "https://github.com/madangryscientist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madangryscientist/hackcove.git",
    "directory": "themes"
  },
  "files": [
    "*.css",
    "NOTICE",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./*.css": "./*.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../.oxlintrc.json --type-aware --deny-warnings && bun ../scripts/check-slop.ts",
    "test": "vitest run",
    "pack-check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "tailwindcss": "^4.3.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "nx": {
    "name": "themes",
    "tags": [
      "kind:theme"
    ],
    "targets": {
      "pack-check": {
        "dependsOn": []
      },
      "test": {
        "inputs": [
          "default",
          "{workspaceRoot}/packages/ui-react/palette.json",
          "{workspaceRoot}/packages/themes-shared/src/**/*"
        ]
      }
    }
  }
}
