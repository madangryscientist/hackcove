{
  "name": "@hackcove/theme-thrifty-paper",
  "version": "0.1.3",
  "description": "The Thrifty Paper light theme for Hack Cove: one CSS file that remaps the Tailwind utilities @hackcove/ui is written against.",
  "keywords": [
    "design-system",
    "hackcove",
    "light-theme",
    "paper",
    "tailwind",
    "tailwindcss",
    "theme"
  ],
  "homepage": "https://github.com/madangryscientist/hackcove/tree/main/themes/thrifty-paper#readme",
  "bugs": {
    "url": "https://github.com/madangryscientist/hackcove/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Jacobus Langner",
    "url": "https://github.com/madangryscientist"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/madangryscientist/hackcove.git",
    "directory": "themes/thrifty-paper"
  },
  "files": [
    "theme.css"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings && bun ../../scripts/check-slop.ts",
    "test": "vitest run",
    "pack-check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "tailwindcss": "^4.3.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "tailwindcss": "^4"
  },
  "nx": {
    "name": "theme-thrifty-paper",
    "tags": [
      "kind:theme"
    ],
    "targets": {
      "pack-check": {
        "dependsOn": []
      }
    }
  }
}
