{
  "name": "hack-cove-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/props.ts && astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check --minimumFailingSeverity error",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings && bun ../../scripts/check-slop.ts",
    "test": "vitest run",
    "deploy": "./deploy.sh",
    "props": "bun scripts/props.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hackcove/themes": "workspace:*",
    "@hackcove/themes-shared": "workspace:*",
    "@hackcove/ui-react": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@astrojs/react": "7.1.0",
    "@storybook/react": "^10.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "1.4.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "astro": "7.4.12",
    "react-docgen-typescript": "^2.4.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "nx": {
    "name": "hack-cove-site"
  }
}
