{
  "name": "hack-cove-site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/props.ts && astro dev --port 4321",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check --minimumFailingSeverity error",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings && bun ../../scripts/check-slop.ts",
    "test": "vitest run",
    "deploy": "./deploy.sh",
    "props": "bun scripts/props.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@hackcove/theme-catppuccin-mocha": "workspace:*",
    "@hackcove/themes-shared": "workspace:*",
    "@hackcove/ui": "workspace:*",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.11",
    "@astrojs/react": "7.1.0",
    "@storybook/react": "^10.6.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/bun": "1.4.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "astro": "7.4.1",
    "react-docgen-typescript": "^2.4.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.7.0",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  },
  "nx": {
    "name": "hack-cove-site",
    "tags": [
      "kind:app"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "{workspaceRoot}/themes/*/theme.css",
          "{workspaceRoot}/themes/*/package.json",
          "{workspaceRoot}/packages/ui/src/**/*",
          "{workspaceRoot}/apps/storybook/src/**/*",
          "{workspaceRoot}/packages/themes-shared/src/**/*",
          "{projectRoot}/src/generated/props.json"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ],
        "dependsOn": [
          "props",
          "^build"
        ]
      },
      "preview": {
        "executor": "nx:run-script",
        "dependsOn": [
          "build"
        ],
        "options": {
          "script": "preview"
        }
      },
      "deploy": {
        "executor": "nx:run-script",
        "dependsOn": [
          "build"
        ],
        "options": {
          "script": "deploy"
        },
        "cache": false
      },
      "typecheck": {
        "dependsOn": [
          "props",
          "^build"
        ]
      },
      "lint": {
        "dependsOn": [
          "props",
          "^build"
        ]
      },
      "test": {
        "inputs": [
          "default",
          "{workspaceRoot}/themes/*/theme.css",
          "{workspaceRoot}/themes/*/package.json",
          "{workspaceRoot}/apps/storybook/src/**/*",
          "{workspaceRoot}/packages/themes-shared/src/**/*",
          "{workspaceRoot}/packages/ui/src/**/*"
        ],
        "dependsOn": [
          "props",
          "^build"
        ]
      },
      "props": {
        "executor": "nx:run-script",
        "options": {
          "script": "props"
        },
        "inputs": [
          "{projectRoot}/scripts/**/*",
          "{workspaceRoot}/packages/ui/src/**/*",
          "{workspaceRoot}/packages/ui/tsconfig*.json"
        ],
        "outputs": [
          "{projectRoot}/src/generated/props.json"
        ]
      },
      "e2e": {
        "executor": "nx:run-script",
        "options": {
          "script": "test:e2e"
        },
        "dependsOn": [
          "build"
        ],
        "cache": false
      }
    }
  }
}
