---
import { ComponentPage, contentsOf, neighbourLinksOf } from "../../components/ComponentPage";
import { Contact } from "../../components/Contact";
import { DocsFrame } from "../../components/DocsFrame";
import { componentPageOf, componentPages } from "../../../../../packages/ui-react/docs/components/index";
import { site } from "../../content/site";
import Base from "../../layouts/Base.astro";

export function getStaticPaths() {
  return componentPages.map((page) => ({ params: { slug: page.slug } }));
}

const page = componentPageOf(Astro.params.slug ?? "");
const { previous, next } = neighbourLinksOf(page);
---

<Base title={`${page.name} · UISlash · ${site.name}`} description={page.summary}>
  <DocsFrame
    client:load
    pathname={Astro.url.pathname}
    title={page.name}
    description={page.summary}
    contents={contentsOf(page)}
    previous={previous}
    next={next}
  >
    <ComponentPage page={page} />
  </DocsFrame>
  <Contact slot="footer" />
</Base>
