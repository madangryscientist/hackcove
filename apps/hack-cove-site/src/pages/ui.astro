---
import { Contact } from "../components/Contact";
import { PageIntro } from "../components/PageIntro";
import { UiPage } from "../components/UiPage";
import { sectionOf, site } from "../content/site";
import Base from "../layouts/Base.astro";

const section = sectionOf("ui");
---

<Base title={`${section.name} — ${site.name}`} description={section.description}>
  <PageIntro title={section.name} subtitle={site.ui.subtitle} />
  <UiPage />
  <Contact slot="footer" />
</Base>
