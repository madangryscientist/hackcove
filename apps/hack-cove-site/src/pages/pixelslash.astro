---
import { Stack } from "@hackcove/ui-react";
import { Contact } from "../components/Contact";
import { PixelSlashHero, PixelSlashPage } from "../components/PixelSlashPage";
import { sectionOf, site } from "../content/site";
import Base from "../layouts/Base.astro";

const section = sectionOf("pixelslash");
---

<Base title={`${section.name} — ${site.name}`} description={section.description}>
  <Stack gap="xl">
    {/* The hero is the page's one island: the install line's copy button needs a click handler. */}
    <PixelSlashHero client:load />
    <PixelSlashPage />
  </Stack>
  <Contact slot="footer" />
</Base>
