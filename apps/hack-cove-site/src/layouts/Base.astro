---
import "../styles/global.css";
import { appShellRootClass } from "@hackcove/ui";
import { SCOPES, THEMES } from "@hackcove/themes-shared";
import { themeScope } from "@hackcove/themes-shared/scope";
import siteCss from "@hackcove/theme-catppuccin-mocha/theme.css?inline";
import { SiteShell } from "../components/SiteShell";
import { ThemePicker } from "../components/ThemePicker";
import { site } from "../content/site";
import { themes } from "../content/themes";
import { folderOfScope, themeScript } from "../content/themeScript";

type Props = {
  title?: string;
  description?: string;
  hideChromeInPrint?: boolean;
};
const {
  title = site.name,
  description = site.tagline,
  hideChromeInPrint = false,
} = Astro.props;
// The class the site ships with (the theme global.css imports), which the picker starts on.
const siteScope = themeScope(siteCss) ?? "";
const themeCss = Object.values(THEMES).join("\n");
const pickerItems = themes.map((theme) => ({ value: theme.folder, label: theme.title }));
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<html lang="en" class={`${siteScope} ${appShellRootClass}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#181825" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <style set:html={themeCss} />
    <script is:inline set:html={themeScript} />
  </head>
  <body>
    <SiteShell pathname={Astro.url.pathname} hideChromeInPrint={hideChromeInPrint}>
      <slot />
      {Astro.slots.has("footer") && <slot name="footer" slot="footer" />}
      <ThemePicker
        slot="controls"
        client:load
        items={pickerItems}
        scopes={SCOPES}
        selected={folderOfScope(siteScope)}
      />
    </SiteShell>
  </body>
</html>
