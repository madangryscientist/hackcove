---
import "../styles/global.css";
import { appShellRootClass } from "@hackcove/ui";
import { SiteShell } from "../components/SiteShell";
import { site } from "../content/site";

type Props = { title?: string; description?: string; hideChromeInPrint?: boolean };
const { title = site.name, description = site.tagline, hideChromeInPrint = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
---

<html lang="en" class={`dark ${appShellRootClass}`}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#000000" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
  </head>
  <body>
    {
      Astro.slots.has("footer") ? (
        <SiteShell hideChromeInPrint={hideChromeInPrint}>
          <slot />
          <slot name="footer" slot="footer" />
        </SiteShell>
      ) : (
        <SiteShell hideChromeInPrint={hideChromeInPrint}>
          <slot />
        </SiteShell>
      )
    }
  </body>
</html>
