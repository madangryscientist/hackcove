---
import "../styles/global.css";
import { ColourSchemeToggle, SiteSearch, appShellRootClassFor } from "@hackcove/ui-react";
import { THEMES } from "@hackcove/themes-shared";
import { SiteShell } from "../components/SiteShell";
import { componentPages } from "../content/components";
import { site } from "../content/site";
import { colourSchemeHeadScript, schemes } from "../content/colourSchemes";

type Props = {
  title?: string;
  description?: string;
  hideChromeInPrint?: boolean;
};
const {
  title = site.name,
  description = site.tagline,
  hideChromeInPrint = false,
} = Astro.props;
// The server cannot know the visitor's scheme, so it renders dark (the site's own look); the head
// script swaps to the remembered or system scheme before first paint.
const themeCss = Object.values(THEMES).join("\n");
const canonical = new URL(Astro.url.pathname, site.url).href;
// Every component page, in rail order, for the header's search. The summaries are written in
// Markdown, so their code ticks are dropped for the plain result line.
const searchItems = componentPages.map((page) => ({
  label: page.name,
  description: page.summary.replaceAll("`", ""),
  href: `/ui/${page.slug}/`,
  keywords: page.api,
}));
---

<html lang="en" class={appShellRootClassFor("dark", schemes)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#181825" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <style set:html={themeCss} />
    <script is:inline set:html={colourSchemeHeadScript} />
  </head>
  <body>
    <SiteShell pathname={Astro.url.pathname} hideChromeInPrint={hideChromeInPrint}>
      <slot />
      {Astro.slots.has("footer") && <slot name="footer" slot="footer" />}
      <SiteSearch slot="controls" client:load label="Search components" items={searchItems} />
      <ColourSchemeToggle
        slot="controls"
        client:load
        schemes={schemes}
        initial="dark"
        size="sm"
      />
    </SiteShell>
  </body>
</html>
