{
  "name": "@hackcove/storybook",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build": "storybook build",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings && bun ../../scripts/check-slop.ts",
    "test:e2e": "playwright test",
    "visual": "bun scripts/visual.ts",
    "visual:upload": "bun scripts/visual.ts --upload"
  },
  "dependencies": {
    "@hackcove/themes-shared": "workspace:*",
    "@hackcove/ui": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "1.4.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.4"
  },
  "nx": {
    "name": "storybook",
    "tags": [
      "kind:app"
    ],
    "targets": {
      "build": {
        "inputs": [
          "default",
          "{workspaceRoot}/themes/*/theme.css",
          "{workspaceRoot}/packages/themes-shared/src/**/*",
          "{workspaceRoot}/packages/ui/src/**/*"
        ],
        "outputs": [
          "{projectRoot}/storybook-static"
        ]
      },
      "e2e": {
        "executor": "nx:run-script",
        "options": {
          "script": "test:e2e"
        },
        "dependsOn": [
          "build"
        ],
        "cache": false
      },
      "visual": {
        "executor": "nx:run-script",
        "options": {
          "script": "visual"
        },
        "dependsOn": [
          "build"
        ],
        "cache": false
      },
      "visual-upload": {
        "executor": "nx:run-script",
        "options": {
          "script": "visual:upload"
        },
        "dependsOn": [
          "build"
        ],
        "cache": false
      }
    }
  }
}
