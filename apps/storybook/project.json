{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "storybook",
  "root": "apps/storybook",
  "sourceRoot": "apps/storybook/src",
  "projectType": "application",
  "tags": ["scope:storybook", "kind:app"],
  "targets": {
    "storybook": {
      "executor": "nx:run-commands",
      "options": { "command": "storybook dev -p 6006", "cwd": "apps/storybook" }
    },
    "build": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "{workspaceRoot}/themes/*/theme.css",
        "{workspaceRoot}/packages/ui/src/**/*"
      ],
      "outputs": ["{projectRoot}/storybook-static"],
      "options": { "command": "storybook build", "cwd": "apps/storybook" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "tsc --noEmit", "cwd": "apps/storybook" }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint -c ../../.oxlintrc.json --type-aware --deny-warnings && bun ../../scripts/check-slop.ts",
        "cwd": "apps/storybook"
      }
    }
  }
}
